# Salin ke `.env` dan/atau `.dev.vars` (Wrangler / `wrangler dev` memakai `.dev.vars`).
# `npm run db:turso:reset-remote` memuat `.env` lalu override dari `.dev.vars`.
TURSO_DATABASE_URL=libsql://logam-mulia-db-xxx.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
# Single key (legacy). Ignored when JINA_API_KEYS is set.
JINA_API_KEY=your_jina_api_key
# Preferred: comma-separated pool; tried in order on 401/402/403 (balance/auth).
# JINA_API_KEYS=key_primary,key_fallback_1,key_fallback_2
